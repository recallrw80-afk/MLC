# C++ 工程 .gitignore（仅本目录树生效）
# ---------------------------------------------------------------------------
# 职责：只管 C++/Qt 特有的产物。全局通用规则（*.o/*.so/IDE/临时文件/敏感配置/
# 文档白名单）由仓库根的 ../.gitignore 负责，此处不重复，避免两处规则漂移。
# 路径相对于本目录（cpp/）。

# ==== CMake / Make 构建目录 ====
/build*/
cmake-build-*/
CMakeUserPresets.json
CMakeLists.txt.user*
compile_commands.json
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt

# ==== Qt 生成物 ====
*.moc
moc_*.cpp
ui_*.h
qrc_*.cpp
*_qml_module_dir_map.qrc
.qmlls.ini
/.qtcreator/
*.qm
*.prl
*.res
*.rc
*_resource.rc

# ==== 打包产物 ====
/cli/dist/
/cli/cmake-build-*/
/gui/bin/

# ==== 本地 Qt 路径 / IDE ====
/.idea/
/.codegraph/

# 注：
# - .env 在仓库根（../.env），由根 .gitignore 忽略；CMake 从 ../../.env 读取 CF key
# - docs/ 已移到仓库根并整体忽略，本目录不再处理
